<UserControl x:Class="SpeakerAnimator.View.Panels.AnimationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             d:DesignHeight="520" d:DesignWidth="310">
    <Grid>
        <StackPanel HorizontalAlignment="Left" Margin="10">

            <TextBlock Text="Audio Source" FontWeight="SemiBold" Margin="0 0 0 5" />

            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                <Button x:Name="LoadAudioBtn" Width="110" HorizontalAlignment="Left"
                        Click="LoadAudioBtn_Click">Load From File...</Button>
                <Label x:Name="AudioFileLabel" Margin="10 0 0 0" MaxWidth="160"
                       VerticalAlignment="Center" Content="No audio"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                <Button x:Name="RecordBtn" Width="110" HorizontalAlignment="Left"
                        Click="RecordBtn_Click">Record</Button>
                <Label x:Name="RecordStatusLabel" Margin="10 0 0 0" Width="140"
                       VerticalAlignment="Center" Content="Idle"/>
            </StackPanel>
            
            <StackPanel x:Name="LivePanel" Margin="0 15 0 0">
                <TextBlock Text="Live" FontWeight="SemiBold" Margin="0 0 0 5" />
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="LiveBtn" Width="110" Height="26" HorizontalAlignment="Left"
                            Click="LiveBtn_Click">Start Live</Button>
                    <Label x:Name="LiveStatusLabel" Margin="10 0 0 0" Width="140"
                           VerticalAlignment="Center" Content="Off"/>
                </StackPanel>
                <TextBlock Text="Animates from the microphone. No sound is played."
                           FontSize="10" Opacity="0.7" TextWrapping="Wrap"
                           MaxWidth="270" Margin="0 4 0 0"/>
            </StackPanel>

            <StackPanel x:Name="ActionsPanel" Margin="0 15 0 0">
                <TextBlock Text="Actions" FontWeight="SemiBold" Margin="0 0 0 5" />

                <Button x:Name="TestAudioBtn" Width="110" Height="26" HorizontalAlignment="Left"
                        Click="TestAudioBtn_Click">Test Audio</Button>

                <Button x:Name="PredictBtn" Width="110" Height="26" HorizontalAlignment="Left"
                        Margin="0 10 0 0" Click="PredictBtn_Click">Predict Visemes</Button>

                <Button x:Name="AnimateBtn" Width="110" Height="26" HorizontalAlignment="Left"
                        Margin="0 10 0 0" Click="AnimateBtn_Click">Animate</Button>
            </StackPanel>

            <StackPanel x:Name="PositionPanel" Margin="0 15 0 0" HorizontalAlignment="Left">
                <TextBlock Text="Playback Position" FontWeight="SemiBold" Margin="0 0 0 5" />

                <Slider x:Name="PositionSlider" Width="270"
                        Minimum="0" Maximum="0"
                        IsEnabled="False"
                        IsMoveToPointEnabled="True"
                        SmallChange="0.01" LargeChange="0.1"
                        ValueChanged="PositionSlider_ValueChanged"
                        Thumb.DragStarted="PositionSlider_DragStarted"
                        Thumb.DragCompleted="PositionSlider_DragCompleted"/>

                <Label x:Name="TimeLabel" Content="0.00s / 0.00s" Padding="0" Margin="0 4 0 0"/>
            </StackPanel>

            <StackPanel x:Name="ResultsPanel" Margin="0 15 0 10" HorizontalAlignment="Left">
                <Grid Width="270">
                    <TextBlock Text="Results" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                    <CheckBox x:Name="FollowCheck" Content="Follow" IsChecked="True"
                              HorizontalAlignment="Right" FontSize="10" VerticalAlignment="Center"/>
                </Grid>

                <TextBlock x:Name="StatusLabel" Text="Load or record audio to begin."
                           TextWrapping="Wrap" MaxWidth="270" Margin="0 5 0 0" />

                <ListView x:Name="ResultsList" Height="150" Width="270" Margin="0 8 0 0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectionChanged="ResultsList_SelectionChanged">
                    <ListView.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF2F80ED"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FF2F80ED"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
                    </ListView.Resources>

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Time" Width="60"
                                DisplayMemberBinding="{Binding Time, StringFormat={}{0:F2}s}"/>
                            <GridViewColumn Header="Viseme" Width="70"
                                DisplayMemberBinding="{Binding Viseme}"/>
                            <GridViewColumn Header="Prob" Width="70"
                                DisplayMemberBinding="{Binding Confidence, StringFormat={}{0:P1}}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </StackPanel>

        </StackPanel>
    </Grid>
</UserControl>