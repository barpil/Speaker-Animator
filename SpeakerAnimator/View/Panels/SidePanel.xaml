<UserControl x:Class="SpeakerAnimator.View.Panels.SidePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SpeakerAnimator.View.Panels"
             xmlns:blend="clr-namespace:SpeakerAnimator.View.Mouth.BlendShapes"
             xmlns:panels="clr-namespace:SpeakerAnimator.View.Panels"
             mc:Ignorable="d"
             d:DesignHeight="480" d:DesignWidth="320">
    <Grid>
        <TabControl>
            
            <TabItem Header="Animate">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <panels:AnimationPanel x:Name="AnimationPanel"/>
                </ScrollViewer>
            </TabItem>
            
            <TabItem Header="Edit Mouth">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10" HorizontalAlignment="Left">
                        
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="MouthOptionCB" Width="160"
                                      SelectionChanged="OnMouthMovementOption_SelectionChange">
                                <ComboBoxItem Content="Rig"/>
                                <ComboBoxItem Content="Blendshapes"/>
                            </ComboBox>
                            <Label x:Name="MouthMovementOptionLabel"
                                   VerticalAlignment="Center"
                                   Margin="10 0 0 0">STATUS</Label>
                        </StackPanel>

                        <StackPanel x:Name="RigPanel" Margin="0 15 0 0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Toggle Editable Points"
                                        Background="Aquamarine"
                                        Width="140" Height="30"
                                        HorizontalAlignment="Left"
                                        x:Name="ToggleEditableBtn"
                                        Click="ToggleEditablePointsBtn_Click"/>
                                <Label x:Name="EditablePointsStatusLabel"
                                       VerticalAlignment="Center"
                                       Margin="10 0 0 0">STATUS</Label>
                            </StackPanel>

                            <Button Content="Reset To Neutrals"
                                    Background="Aquamarine"
                                    Width="140" Height="30"
                                    Margin="0 10 0 0"
                                    HorizontalAlignment="Left"
                                    x:Name="ResetToNeutralsBtn"
                                    Click="ResetToNeutralsBtn_Click"/>
                        </StackPanel>
                        
                        <blend:BlendShapesPanel x:Name="BlendShapesPanel"
                                                Margin="0 10 0 0"/>
                        
                        <Expander x:Name="DebugToolsPanel"
                                  Header="Debug Tools"
                                  Margin="0 20 0 0"
                                  IsExpanded="False"
                                  Visibility="Collapsed">
                            <StackPanel Margin="0 10 0 0">
                                <Button Content="Print KeyPoint List"
                                        Background="Aquamarine"
                                        Width="140" Height="30"
                                        HorizontalAlignment="Left"
                                        x:Name="PrintKeyPointListBtn"
                                        Click="PrintKeyPointListBtn_Click"/>
                                
                            </StackPanel>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>