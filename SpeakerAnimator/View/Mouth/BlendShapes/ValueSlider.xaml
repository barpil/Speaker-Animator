<UserControl x:Class="SpeakerAnimator.View.Mouth.BlendShapes.ValueSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SpeakerAnimator.View.Mouth.BlendShapes"
             mc:Ignorable="d"
             d:DesignHeight="45">
    <Grid Width="200">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Label Content="{Binding Title,
                 RelativeSource={RelativeSource AncestorType={x:Type local:ValueSlider}}, FallbackValue=Title}"
                   FontSize="11"
                   Padding="0"
                   Foreground="Gray"
                   />

            <TextBlock Text="{Binding Value, ElementName=Slider,
                                  StringFormat={}{0:F2}, FallbackValue=0.00}"
                       FontSize="11"
                       Foreground="Gray"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       />
        </DockPanel>

        <Slider x:Name="Slider"
                Grid.Row="1"
                Minimum="0"
                Maximum="1"
                Value="0"
                TickFrequency="0.01"
                ValueChanged="Slider_ValueChanged"/>
    </Grid>
</UserControl>
