<UserControl x:Class="SpeakerAnimator.View.Mouth.BlendShapes.BlendShapesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SpeakerAnimator.View.Mouth.BlendShapes"
             mc:Ignorable="d"
             d:DesignHeight="350" d:DesignWidth="300">
    <Grid>
        <StackPanel HorizontalAlignment="Left" Margin="10">

            <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                <Button x:Name="ToggleEditBtn" Width="80" HorizontalAlignment="Left" Click="ToggleEditBtn_Click">Edit Poses</Button>
                <Label x:Name="EditStatusLabel" Margin="10 0 0 0" Width="50" VerticalAlignment="Center">Status</Label>
            </StackPanel>
            
            <StackPanel x:Name="PosePanel" Margin="0 15 0 0">
                <TextBlock Text="Load Pose" FontWeight="SemiBold" Margin="0 0 0 5" />
                <ComboBox x:Name="PoseCB"
                          SelectionChanged="PoseCB_SelectionChanged">

                    <ComboBoxItem Content="Neutral"/>
                    <ComboBoxItem Content="Open"/>
                    <ComboBoxItem Content="Closed"/>
                    <ComboBoxItem Content="Wide"/>
                    <ComboBoxItem Content="Pucker"/>
                    <ComboBoxItem Content="Stretch"/>

                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <EventSetter Event="PreviewMouseLeftButtonUp"
                                         Handler="PoseItem_MouseUp"/>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>


                <Button x:Name="SavePoseBtn" Width="100" Height="26" Margin="0 20 0 0" HorizontalAlignment="Left"
                        Click="SavePoseBtn_Click">
                    Save Current Pose
                    <Button.ContextMenu>
                        <ContextMenu x:Name="SaveContextMenu">
                            <MenuItem Header="Choose pose to override" IsEnabled="False" FontWeight="Bold" />
                            <Separator />
                            <MenuItem Header="Neutral" Click="SavePoseMenuItem_Click" />
                            <MenuItem Header="Open" Click="SavePoseMenuItem_Click" />
                            <MenuItem Header="Closed" Click="SavePoseMenuItem_Click" />
                            <MenuItem Header="Wide" Click="SavePoseMenuItem_Click" />
                            <MenuItem Header="Pucker" Click="SavePoseMenuItem_Click" />
                            <MenuItem Header="Stretch" Click="SavePoseMenuItem_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Width="120" Height="26" HorizontalAlignment="Left" Margin="0 10 0 0"
                        Click="ResetBtn_Click">Reset To Default</Button>
            </StackPanel>
            
            <StackPanel x:Name="SliderPanel" Margin="0 15 0 10" HorizontalAlignment="Left">
                <local:ValueSlider Title="Top-Lip-Up" />
                <local:ValueSlider Margin="0 10 0 0" Title="Bottom-Lip-Down" />
                <local:ValueSlider Margin="0 10 0 0" Title="Mouth-Open" />
                <local:ValueSlider Margin="0 10 0 0" Title="Pucker" />
                <local:ValueSlider Margin="0 10 0 0" Title="Wide" />
            </StackPanel>

        </StackPanel>
    </Grid>
</UserControl>